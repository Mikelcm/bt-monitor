# ─── Python ──────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Project data / runtime artifacts ────────────────────────────────
# Every JSON in data/ is generated by a scan — don't commit run output.
data/*.json
data/*.db
data/*.html
data/*.png
data/*.log
data/*.err
data/_*

# Keep the data/ folder itself so cloners don't have to mkdir.
!data/.gitkeep

# ─── Secrets ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Playwright browsers (these live in user-global path anyway) ─────
ms-playwright/

# ─── Editors / IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ─── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Misc ────────────────────────────────────────────────────────────
*.bak
*.tmp
.coverage
htmlcov/
