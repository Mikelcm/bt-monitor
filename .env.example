# Copy to .env and fill in. NEVER commit .env (it's gitignored).
#
# DB schema: in production (Postgres) the schema is managed by Alembic. The
# Docker entrypoint runs `alembic upgrade head` automatically before the app
# starts. For local dev without Docker, the default SQLite backend self-creates
# its schema (no migration step needed).

# --- Postgres (docker-compose) ---
POSTGRES_USER=btmonitor
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bt_monitor

# --- Dashboard auth (required in production) ---
# When set, the dashboard requires login: humans get a branded /login page with
# a signed session cookie; automation/API clients can still use HTTP Basic.
BT_MONITOR_AUTH_USER=admin
BT_MONITOR_AUTH_PASS=change-me-too
# Optional explicit session-signing key (else derived from the credentials).
BT_MONITOR_SECRET_KEY=

# --- What may be scanned (SSRF allowlist; comma-separated) ---
BT_MONITOR_ALLOWED_HOSTS=bancatransilvania.ro

# --- Target + alerting ---
BT_MONITOR_BASE_URL=https://www.bancatransilvania.ro
# Teams Incoming Webhook (Power Automate Workflows URL recommended)
BT_MONITOR_TEAMS_WEBHOOK=
BT_MONITOR_TEAMS_FORMAT=adaptive
# Public dashboard URL (used to build links in alerts)
BT_MONITOR_DASHBOARD_URL=

# --- Logging ---
BT_MONITOR_LOG_LEVEL=INFO
BT_MONITOR_LOG_FORMAT=json

# --- Performance regression detection (vs 7-day latency baseline) ---
# Flag a page as regressed when its recent average is >= FACTOR x its baseline.
BT_MONITOR_PERF_FACTOR=1.5
BT_MONITOR_PERF_CHECK_INTERVAL_MIN=15
# BT_MONITOR_PERF_MIN_MS=150   # ignore very fast pages (noise floor)
